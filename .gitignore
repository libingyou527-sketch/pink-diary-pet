# Dependencies
node_modules/

# Local/private data
.tmp/
backup/
**/backup-*/
**/orig/
**/patched/
*.orig
*.patched

# Secrets and runtime config
.env
.env.*
!.env.example
config/config.yml
config/config.local.*
**/cordis.patch.yml.bak*
**/cordis.patch.yml.bak-*
*.bak
*.bak-*

# Pet memory / identity / logs
identity.json
memory.json
user-memory.json
user-group-memory.json
user-profiles.json
pet-qq-memory.json
context-blocks.json
pet-inbound.log
*.log

# Runtime data（只忽略仓库根下的数据目录，别误伤 src/plugins/pink-diary 这类源码）
/diary/
/pink-diary/
/pictures/
*.sqlite
*.db

# Model / media assets (bring your own; see assets/README.md)
assets/model/
assets/**/*.webm
assets/**/*.moc3
assets/**/*.wpk
assets/**/*.bin3
assets/**/*.png
*.wpk

# Emoji source images (local originals; only the compressed webp set ships)
assets/emojis/

# Local media tools (ffmpeg 二进制等，不上传)
# 例外：GPT-SoVITS 的启停脚本要进版本库（纯文本，无二进制），
# 所以先把 tools/ 降级为 tools/*，再单独放行 tools/gpt-sovits/
tools/*
!tools/gpt-sovits/
!tools/gpt-sovits/*

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- fork 包（packages/core）的媒体资产：不入库，由 scripts/install.mjs 从本地复制 ----
# 例外：assets/pic/ 是 UI 图标（通知图标、光标），体积小且是我们自己的美术，必须入库
packages/core/assets/emojis/
packages/core/assets/webm/
packages/core/assets/fonts/
packages/core/assets/memes/